---
import { site } from '../data/site';
import { siteLinkedinLink } from '../lib/details';
// Not Zarif's team-list LinkedIn (that stays colour-brand on project pages): this is the site-wide contact, kept
// monochrome to match the email/phone glyphs beside it.
const linkedin = siteLinkedinLink(site.linkedin);
---
<footer class="footer">
  <div class="container row">
    <ul>
      <li><span aria-hidden="true">✉ </span><a href={`mailto:${site.email}`}>{site.email}</a></li>
      <li><span aria-hidden="true">☎ </span><a href={`tel:${site.phoneTel}`}>{site.phoneDisplay}</a></li>
      {linkedin && (
        <li>
          <a href={linkedin.href} target={linkedin.target} rel={linkedin.rel} aria-label={linkedin['aria-label']}>
            <svg aria-hidden="true" viewBox="0 0 24 24" width="16" height="16"><path fill="currentColor" d="M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0z"/></svg>
            LinkedIn
          </a>
        </li>
      )}
    </ul>
    <p>© 2026 {site.name}</p>
  </div>
</footer>
<style>
  .footer { border-top: 1px solid var(--border); margin-top: 96px; padding-block: 28px; color: var(--dim); font-size: .9rem; }
  .row { display: flex; flex-wrap: wrap; gap: 12px 32px; justify-content: space-between; align-items: center; }
  ul { list-style: none; display: flex; flex-wrap: wrap; gap: 8px 24px; margin: 0; padding: 0; }
  a { color: var(--muted); text-decoration: none; display: inline-flex; align-items: center; gap: 6px; }
  a:hover { color: var(--text); text-decoration: underline; }
  a svg { flex-shrink: 0; }
  p { margin: 0; }
</style>
