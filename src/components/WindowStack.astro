---
/**
 * Related screenshots as overlapping app windows (or phones) on a solid accent backdrop. Images come in groups
 * (see groupImages); successive groups mirror their composition. Every image opens the page's lightbox: each link
 * carries `data-index` into the enclosing `[data-gallery]` list, and its href is the full-size image (no-JS).
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { groupImages } from '../lib/details';

interface Item { src: ImageMetadata; alt: string; caption?: string; full: string; index: number }
interface Props { items: Item[]; device: 'laptop' | 'phone' }
const { items, device } = Astro.props;
const phone = device === 'phone';
const groups = groupImages(items, phone ? 4 : 3);
const sizes = phone ? '(max-width: 899px) 30vw, 240px' : '(max-width: 899px) 85vw, 720px';
---
<div class:list={['stacks', { phones: phone }]}>
  {groups.map((g, gi) => (
    <div class:list={['panel', `n${g.length}`, { mirror: gi % 2 === 1 }]}>
      {g.map((it, k) => phone ? (
        <a class="win phone" style={`--k:${k}`} href={it.full} data-open-lightbox data-index={it.index} aria-label={`View larger: ${it.alt}`}>
          <span class="scr">
            <span class="island" aria-hidden="true"></span>
            <Image src={it.src} alt={it.alt} widths={[240, 400, 600].filter((w) => w <= it.src.width * 1.6)} sizes={sizes} loading="lazy" />
          </span>
        </a>
      ) : (
        <a class="win" style={`--k:${k}`} href={it.full} data-open-lightbox data-index={it.index} aria-label={`View larger: ${it.alt}`}>
          <span class="chrome" aria-hidden="true">
            <span class="dots"><i></i><i></i><i></i></span>
            {it.caption && <span class="title">{it.caption}</span>}
          </span>
          <Image src={it.src} alt={it.alt} widths={[480, 800, 1200].filter((w) => w <= it.src.width * 1.6)} sizes={sizes} loading="lazy" />
        </a>
      ))}
    </div>
  ))}
</div>

<style>
  .stacks { display: grid; gap: clamp(16px, 2.4vw, 28px); }
  .panel {
    --pad: clamp(18px, 5vw, 64px);
    position: relative; padding: var(--pad); border-radius: calc(var(--radius) + 8px); overflow: hidden;
    background: var(--panel, #2449d8);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, .12);
  }
  /* Faint light from the top-left keeps the solid colour from looking flat. */
  .panel::before { content: ''; position: absolute; inset: 0; background: radial-gradient(80% 70% at 15% 0%, rgba(255, 255, 255, .1), transparent 60%); pointer-events: none; }

  .win { position: relative; display: block; text-decoration: none; cursor: zoom-in; border-radius: 12px; overflow: hidden; background: #fff;
    box-shadow: 0 1px 0 rgba(255, 255, 255, .4) inset, 0 28px 56px -18px rgba(6, 10, 48, .6), 0 10px 24px -8px rgba(6, 10, 48, .35); }
  .win :global(img) { width: 100%; height: auto; display: block; }
  .chrome { display: flex; align-items: center; gap: 12px; height: clamp(22px, 2.6vw, 32px); padding: 0 12px; background: #eef0f4; border-bottom: 1px solid #dadde4; }
  .dots { display: flex; gap: 6px; flex: none; }
  .dots i { width: clamp(7px, .8vw, 10px); aspect-ratio: 1; border-radius: 50%; background: #ff5f57; }
  .dots i:nth-child(2) { background: #febc2e; } .dots i:nth-child(3) { background: #28c840; }
  .title { flex: 1; min-width: 0; text-align: center; margin-right: 46px; font: 600 clamp(.62rem, .9vw, .76rem)/1 var(--font-body); color: #4a4f5c; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

  /* Overlap: each window after the first sits lower and to the other side, covering part of the one before. */
  .stacks:not(.phones) .win { width: 64%; }
  .stacks:not(.phones) .win + .win { margin-top: -21%; }
  .stacks:not(.phones) .win:nth-child(odd) { margin-right: auto; }
  .stacks:not(.phones) .win:nth-child(even) { margin-left: auto; }
  .stacks:not(.phones) .n3 .win { width: 56%; }
  .stacks:not(.phones) .n3 .win + .win { margin-top: -19%; }
  .stacks:not(.phones) .n3 .win:nth-child(3) { margin-inline: auto; }
  .stacks:not(.phones) .mirror .win:nth-child(odd) { margin-left: auto; margin-right: 0; }
  .stacks:not(.phones) .mirror .win:nth-child(even) { margin-right: auto; margin-left: 0; }
  .stacks:not(.phones) .mirror.n3 .win:nth-child(3) { margin-inline: auto; }

  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .win { transition: translate .3s ease, box-shadow .3s ease; }
    .win:hover { translate: 0 -6px; z-index: 5; box-shadow: 0 1px 0 rgba(255, 255, 255, .4) inset, 0 40px 70px -20px rgba(6, 10, 48, .7), 0 12px 28px -8px rgba(6, 10, 48, .4); }
  }
  .win:focus-visible { outline: 3px solid #fff; outline-offset: 3px; z-index: 6; }

  /* ---------- Phones: a fanned row of handsets ---------- */
  .phones .panel { display: flex; justify-content: center; align-items: center; padding-block: clamp(28px, 6vw, 72px); }
  .win.phone { flex: 0 1 25%; max-width: 230px; margin: 0 0 0 -3.5%; padding: 2.2%; border-radius: 15% / 7.5%; background: linear-gradient(145deg, #2c2d31, #0c0c0e 40%, #18181b);
    box-shadow: 0 0 0 1.5px #4a4b50 inset, 0 30px 50px -16px rgba(6, 10, 48, .7), 0 8px 18px -6px rgba(6, 10, 48, .4);
    translate: 0 calc((var(--k) - var(--c)) * (var(--k) - var(--c)) * 4% - 6%); z-index: calc(10 - (var(--k) - var(--c)) * (var(--k) - var(--c)) * 2); }
  .phones .n1 { --c: 0; } .phones .n2 { --c: .5; } .phones .n3 { --c: 1; } .phones .n4 { --c: 1.5; }
  .win.phone:first-child { margin-left: 0; }
  /* The screenshots have no status bar, so the screen starts with a black strip that holds the island. */
  .scr { position: relative; display: block; overflow: hidden; border-radius: 12% / 5.6%; background: #000; padding-top: 10%; }
  .win.phone :global(img) { aspect-ratio: 395 / 805; object-fit: cover; object-position: top; }
  .island { position: absolute; top: 1.3%; left: 50%; translate: -50% 0; width: 30%; height: 2.5%; border-radius: 99px; background: #1a1a1d; box-shadow: inset 0 0 0 1px #2a2a2e; }
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .win.phone:hover { translate: 0 calc((var(--k) - var(--c)) * (var(--k) - var(--c)) * 4% - 9%); z-index: 20; }
  }

  @media (max-width: 899px) {
    .stacks:not(.phones) .win, .stacks:not(.phones) .n3 .win { width: 86%; }
    .stacks:not(.phones) .win + .win, .stacks:not(.phones) .n3 .win + .win { margin-top: -12%; }
    .win.phone { flex-basis: 30%; margin-left: -6%; }
  }
  /* Narrow phones: two handsets per row, the second row tucked up behind the first. */
  @media (max-width: 599px) {
    .phones .panel { flex-wrap: wrap; }
    .phones .n3 .win.phone, .phones .n4 .win.phone { flex-basis: 46%; margin-left: -5%; }
    .phones .n3 .win.phone:nth-child(odd), .phones .n4 .win.phone:nth-child(odd) { margin-left: 0; }
    .phones .n3 .win.phone:nth-child(n + 3), .phones .n4 .win.phone:nth-child(n + 3) { margin-top: -12%; }
  }
</style>
