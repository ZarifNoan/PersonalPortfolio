---
/**
 * Related screenshots as overlapping clean panels (or phones) on a backdrop in the app's own colours (the page sets
 * --theme-from/--theme-to/--theme-accent/--theme-ring, see src/lib/theme.ts). Images come in groups
 * (see groupImages); successive groups mirror their composition. Every image opens the page's lightbox: each link
 * carries `data-index` into the enclosing `[data-gallery]` list, and its href is the full-size image (no-JS).
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { groupImages } from '../lib/details';

/** `framed`: a pre-rendered phone with the screenshot on its screen (scripts/make-phone-frames.py), for phone galleries. */
interface Item { src: ImageMetadata; alt: string; full: string; index: number; framed?: ImageMetadata }
interface Props {
  items: Item[]; device: 'laptop' | 'phone';
  /** Charts and diagrams (screenFit: contain): two windows per group, staggered side by side without covering each
   * other, so no axis, legend or data point is hidden. */
  charts?: boolean;
}
const { items, device, charts = false } = Astro.props;
const phone = device === 'phone';
const groups = groupImages(items, phone ? 4 : charts ? 2 : 3);
const sizes = phone ? '(max-width: 599px) 42vw, (max-width: 899px) 22vw, 200px' : '(max-width: 899px) 85vw, 720px';
---
<div class:list={['stacks', { phones: phone, charts }]}>
  {groups.map((g, gi) => (
    <div class:list={['panel', `n${g.length}`, { mirror: gi % 2 === 1 }]}>
      {g.map((it, k) => phone ? (
        <a class="win phone" href={it.full} data-open-lightbox data-index={it.index} aria-label={`View larger: ${it.alt}`}>
          <Image src={it.framed ?? it.src} alt={it.alt} widths={[240, 400, 600, 800].filter((w) => w <= (it.framed ?? it.src).width)} sizes={sizes} loading="lazy" />
        </a>
      ) : (
        <a class="win" style={`--k:${k};--ar:${(it.src.width / it.src.height).toFixed(3)}`} href={it.full} data-open-lightbox data-index={it.index} aria-label={`View larger: ${it.alt}`}>
          <Image src={it.src} alt={it.alt} widths={[480, 800, 1200].filter((w) => w <= it.src.width * 1.6)} sizes={sizes} loading="lazy" />
        </a>
      ))}
    </div>
  ))}
</div>

<style>
  .stacks { display: grid; gap: clamp(16px, 2.4vw, 28px); }
  .panel {
    --pad: clamp(18px, 5vw, 64px);
    position: relative; padding: var(--pad); border-radius: calc(var(--radius) + 8px); overflow: hidden; isolation: isolate;
    background: linear-gradient(135deg, var(--theme-from, #1b2a4a), var(--theme-to, #0f1a2e));
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, .12);
  }
  /* A soft pool of the app's accent colour and light from the top-left keep the gradient from looking flat. */
  .panel::before { content: ''; position: absolute; inset: 0; z-index: -1; pointer-events: none;
    background:
      radial-gradient(60% 60% at 88% 100%, color-mix(in srgb, var(--theme-accent, #fff) 30%, transparent), transparent 70%),
      radial-gradient(80% 70% at 12% 0%, rgba(255, 255, 255, .14), transparent 60%); }
  .mirror::before { transform: scaleX(-1); }

  /* Clean screenshot panels: rounded corners, a hairline edge and a soft two-layer shadow. */
  .win { position: relative; display: block; text-decoration: none; cursor: zoom-in; border-radius: 12px; overflow: hidden; background: #fff;
    box-shadow: 0 0 0 1px color-mix(in srgb, var(--theme-ring, #fff) 12%, transparent), 0 30px 60px -22px rgba(4, 8, 24, .55), 0 10px 24px -10px rgba(4, 8, 24, .35); }
  .win :global(img) { width: 100%; height: auto; display: block; }

  /* Overlap: each window after the first sits lower and to the other side, covering part of the one before. */
  .stacks:not(.phones):not(.charts) .win { width: 64%; }
  .stacks:not(.phones):not(.charts) .win + .win { margin-top: -17%; }
  .stacks:not(.phones):not(.charts) .win:nth-child(odd) { margin-right: auto; }
  .stacks:not(.phones):not(.charts) .win:nth-child(even) { margin-left: auto; }
  .stacks:not(.phones):not(.charts) .n3 .win { width: 56%; }
  .stacks:not(.phones):not(.charts) .n3 .win + .win { margin-top: -16%; }
  .stacks:not(.phones):not(.charts) .n3 .win:nth-child(3) { margin-inline: auto; }
  .stacks:not(.phones):not(.charts) .mirror .win:nth-child(odd) { margin-left: auto; margin-right: 0; }
  .stacks:not(.phones):not(.charts) .mirror .win:nth-child(even) { margin-right: auto; margin-left: 0; }
  .stacks:not(.phones):not(.charts) .mirror.n3 .win:nth-child(3) { margin-inline: auto; }

  /* Charts: a staggered pair that never overlaps. */
  .stacks.charts .panel { display: flex; align-items: flex-start; gap: 3%; }
  /* Widths in proportion to aspect ratio, so a pair of charts has about the same height. */
  .stacks.charts .win { width: auto; flex: var(--ar, 1) 1 0; min-width: 0; margin: 0; }
  .stacks.charts .win + .win { margin-top: 9%; }
  .stacks.charts .mirror .win:first-child { margin-top: 9%; }
  .stacks.charts .mirror .win + .win { margin-top: 0; }

  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .win { transition: translate .3s ease, box-shadow .3s ease; }
    .win:hover { translate: 0 -6px; z-index: 5; box-shadow: 0 0 0 1px color-mix(in srgb, var(--theme-ring, #fff) 16%, transparent), 0 40px 70px -20px rgba(4, 8, 24, .65), 0 12px 28px -8px rgba(4, 8, 24, .4); }
  }
  .win:focus-visible { outline: 3px solid var(--theme-ring, #fff); outline-offset: 3px; z-index: 6; }

  /* ---------- Phones: a row of realistic handsets, spaced apart, alternately raised and lowered ----------
     Each image is a pre-rendered phone (frame, keys, glass and contact shadow are in the PNG), so the link itself is
     transparent: no panel background, radius or box-shadow. The PNG's transparent margin (~7% each side) is part of
     the spacing. */
  .phones .panel { display: flex; justify-content: center; align-items: center; gap: clamp(8px, 3vw, 40px); padding-block: clamp(40px, 7vw, 88px); }
  .win.phone { --lift: 0px; flex: 0 1 200px; min-width: 0; border-radius: 28px; background: none; box-shadow: none; overflow: visible;
    translate: 0 calc(var(--shift) + var(--lift)); }
  .win.phone:nth-child(odd) { --shift: -5.5%; }
  .win.phone:nth-child(even) { --shift: 5.5%; }
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .win.phone:hover { --lift: -8px; box-shadow: none; }
  }

  @media (max-width: 899px) {
    .stacks:not(.phones):not(.charts) .win, .stacks:not(.phones):not(.charts) .n3 .win { width: 86%; }
    .stacks:not(.phones):not(.charts) .win + .win, .stacks:not(.phones):not(.charts) .n3 .win + .win { margin-top: -12%; }
    .stacks.charts .panel { flex-direction: column; gap: 14px; }
    .stacks.charts .win { width: 88%; flex: none; }
    .stacks.charts .win + .win, .stacks.charts .mirror .win:first-child, .stacks.charts .mirror .win + .win { margin-top: 0; }
    .stacks.charts .win:nth-child(even) { align-self: flex-end; }
  }
  /* Narrow phones: a 2 x 2 grid; the right-hand phone of each row sits a little lower. */
  @media (max-width: 599px) {
    .phones .panel { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px 6%; padding: 24px 6% 32px; }
    .phones .n1 { grid-template-columns: minmax(0, 1fr); padding-inline: 25%; }
    .win.phone:nth-child(odd) { --shift: -2.5%; }
    .win.phone:nth-child(even) { --shift: 2.5%; }
  }
</style>
