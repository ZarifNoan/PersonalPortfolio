---
/**
 * All renders as an editorial mosaic: a large feature beside two stacked tiles, then pairs (see mosaicLayout).
 * Each tile opens the page's lightbox (href = full-size render without JS).
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { mosaicLayout } from '../lib/details';

interface Item { src: ImageMetadata; alt: string; full: string; index: number }
interface Props { items: Item[] }
const { items } = Astro.props;
const layout = mosaicLayout(items.length);
// The sides of a mirrored trio (feature on the right) sit in the first columns.
const mirroredSide = layout.map((t, i) => t === 'side' && (layout[i + 1] === 'feature-end' || layout[i + 2] === 'feature-end'));
const sizes: Record<string, string> = {
  feature: '(max-width: 899px) 100vw, 760px', 'feature-end': '(max-width: 899px) 100vw, 760px',
  side: '(max-width: 899px) 50vw, 380px', half: '(max-width: 899px) 50vw, 570px', full: '(max-width: 899px) 100vw, 1140px',
};
---
<ul class="mosaic">
  {items.map((it, i) => (
    <li class:list={['tile', layout[i], { 'side-start': mirroredSide[i] }]}>
      <a href={it.full} data-open-lightbox data-index={it.index} aria-label={`View larger: ${it.alt}`}>
        <Image src={it.src} alt={it.alt} widths={[480, 800, 1200, 1600].filter((w) => w <= it.src.width)} sizes={sizes[layout[i]!]!} loading={i < 3 ? 'eager' : 'lazy'} />
      </a>
    </li>
  ))}
</ul>

<style>
  .mosaic { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(6, 1fr); grid-auto-flow: row dense; gap: clamp(8px, 1.2vw, 14px); }
  .tile { position: relative; min-width: 0; border-radius: 14px; overflow: hidden; background: #05050b; }
  .tile a { display: block; height: 100%; cursor: zoom-in; }
  .tile :global(img) { width: 100%; height: 100%; object-fit: cover; aspect-ratio: 16 / 9; }
  .feature { grid-column: 1 / span 4; grid-row: span 2; }
  .feature-end { grid-column: 3 / span 4; grid-row: span 2; }
  .feature :global(img), .feature-end :global(img) { aspect-ratio: auto; }
  .side { grid-column: 5 / span 2; }
  .side.side-start { grid-column: 1 / span 2; }
  .half { grid-column: span 3; }
  .full { grid-column: 1 / -1; }
  .full :global(img) { aspect-ratio: 21 / 9; }
  /* Hairline and a soft inner edge so renders sit on the dark page like prints. */
  .tile::after { content: ''; position: absolute; inset: 0; border-radius: inherit; box-shadow: inset 0 0 0 1px rgba(255, 255, 255, .08); pointer-events: none; }
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .tile :global(img) { transition: scale .6s cubic-bezier(.2, .7, .2, 1), filter .4s ease; }
    .tile:hover :global(img) { scale: 1.035; filter: brightness(1.06); }
  }
  .tile a:focus-visible { outline: 3px solid var(--viz); outline-offset: -3px; border-radius: 14px; }
  @media (max-width: 899px) {
    .mosaic { grid-template-columns: repeat(2, 1fr); }
    .feature, .feature-end, .full { grid-column: 1 / -1; grid-row: auto; }
    .feature :global(img), .feature-end :global(img), .full :global(img) { aspect-ratio: 16 / 9; }
    .side, .side.side-start, .half { grid-column: span 1; }
  }
</style>
