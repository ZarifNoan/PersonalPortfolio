---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import DeviceMockup from './DeviceMockup.astro';
interface Props {
  id: string; title: string; eyebrow: string; tags: string[]; description: string;
  /** The project's one listing picture (its cover image). */
  cover: { src: ImageMetadata; alt: string };
  /** Software covers are shown on a device; 3D covers are shown as the render itself. */
  device?: 'laptop' | 'phone'; screenFit?: 'cover' | 'contain';
  href: string; filterSlugs: string[]; reverse: boolean; accent: 'sw' | 'viz'; eager?: boolean;
}
const { id, title, eyebrow, tags, description, cover, device, screenFit, href, filterSlugs, reverse, accent, eager = false } = Astro.props;
const sizes = '(max-width: 899px) calc(100vw - 32px), 640px';
---
<section id={id} class:list={['project', `accent-${accent}`, { reverse }]} data-filter-item data-filter-values={filterSlugs.join(' ')} data-reveal aria-labelledby={`${id}-title`}>
  <!-- The picture repeats the "Learn more" link for pointer users; it is hidden from keyboard and screen readers. -->
  <a class="media" href={href} tabindex="-1" aria-hidden="true" data-cover>
    {device ? (
      <DeviceMockup src={cover.src} alt={cover.alt} device={device} fit={screenFit} sizes={sizes} eager={eager} />
    ) : (
      <span class="render"><Image src={cover.src} alt={cover.alt} widths={[480, 800, 1200]} sizes={sizes} loading={eager ? 'eager' : 'lazy'} /></span>
    )}
  </a>
  <div class="text">
    <p class="eyebrow">{eyebrow}</p>
    <h2 id={`${id}-title`}>{title}</h2>
    <p class="desc">{description}</p>
    <ul class="tags" aria-label="Tech and tags">{tags.map((t) => <li class="glass">{t}</li>)}</ul>
    <a class="more" href={href}>Learn more<span class="visually-hidden"> about {title}</span> <span class="arrow" aria-hidden="true">→</span></a>
  </div>
</section>

<style>
  .project { display: grid; grid-template-columns: 1.15fr 1fr; gap: clamp(24px, 4vw, 56px); align-items: center; padding-block: clamp(40px, 6vw, 72px); border-top: 1px solid var(--border); }
  .project.reverse .media { order: 2; }
  .media { display: block; min-width: 0; border-radius: var(--radius); box-shadow: 0 0 0 1px var(--border); }
  .render { display: block; aspect-ratio: 16 / 10; border-radius: var(--radius); overflow: hidden; background: #05050b; }
  .render :global(img) { width: 100%; height: 100%; object-fit: cover; }
  /* Hover lift on the picture. It uses translate on .media, not the section, which the scroll reveal translates. */
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .media { transition: translate .25s ease, box-shadow .25s ease; }
    .project:hover .media { translate: 0 -4px; box-shadow: 0 0 0 1px color-mix(in srgb, var(--accent) 45%, var(--border)), 0 16px 36px rgba(0,0,0,.45); }
  }
  .accent-sw { --accent: var(--sw); } .accent-viz { --accent: var(--viz); }
  .eyebrow { margin: 0 0 8px; color: var(--accent); font-weight: 600; font-size: .85rem; letter-spacing: .04em; }
  h2 { font-size: clamp(1.4rem, 2.6vw, 2rem); font-weight: 800; }
  .desc { color: var(--muted); margin: 14px 0 18px; }
  .tags { list-style: none; display: flex; flex-wrap: wrap; gap: 8px; margin: 0; padding: 0; }
  .tags li { padding: 4px 12px; font-size: .8rem; color: var(--text); }
  .more { display: inline-flex; align-items: center; gap: 8px; margin-top: 22px; padding: 10px 20px; border-radius: 999px; font-weight: 600; text-decoration: none; color: #0b0b14; background: var(--accent); transition: background .2s, gap .2s; }
  .more:hover { background: color-mix(in srgb, var(--accent) 82%, #fff); gap: 12px; }
  .more:focus-visible { outline-color: var(--text); }
  @media (max-width: 899px) { .project { grid-template-columns: 1fr; } .project.reverse .media { order: 0; } }
</style>
