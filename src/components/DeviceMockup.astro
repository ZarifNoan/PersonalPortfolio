---
/**
 * A project's cover screenshot shown on a device, as a 16:10 scene.
 * - laptop: a front-view laptop built in CSS (bezel, camera notch, aluminium base with lip, contact shadow) on a
 *   soft, muted studio backdrop. The screenshot is a responsive <Image>.
 * - phone: a hand holding a phone in a dim room (Unsplash photo, see README credits; prepared by
 *   scripts/make-phone-scene.py). The screenshot is mapped onto the phone's screen by an SVG affine transform in
 *   the photo's own pixel space, so it stays registered at every width.
 */
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import phoneScene from '../assets/mockups/phone-hand.jpg';
import phoneThumb from '../assets/mockups/phone-thumb.png';

interface Props {
  src: ImageMetadata;
  alt: string;
  device: 'laptop' | 'phone';
  fit?: 'cover' | 'contain';
  /** Rendered width hint for responsive images. */
  sizes: string;
  eager?: boolean;
}
const { src, alt, device, fit = 'cover', sizes, eager = false } = Astro.props;

// Phone scene geometry, in the scene's 1400 × 875 design space (printed by scripts/make-phone-scene.py).
const SCENE_W = 1400, SCENE_H = 875;
const QUAD: [number, number][] = [[574, 196], [790, 181], [881, 756], [635, 787]]; // TL, TR, BR, BL
const SCREEN_W = 395, SCREEN_H = 805; // screenshot space (Fixer's screenshots are ~395 × 805)
// Least-squares affine from the screenshot rectangle onto QUAD (max corner error ~7px; the clip below hides it).
const MATRIX = 'matrix(0.58013 -0.05776 0.09365 0.71843 567.73 202.24)';
const THUMB = { x: 835, y: 420.5, w: 91, h: 225.5 };

/** A rounded quadrilateral path (corner radius r, in scene pixels). */
function roundedQuad(q: [number, number][], r: number): string {
  const n = q.length;
  const pts = q.map((p, i) => {
    const prev = q[(i + n - 1) % n]!, next = q[(i + 1) % n]!;
    const to = (o: [number, number]) => { const dx = o[0] - p[0], dy = o[1] - p[1], l = Math.hypot(dx, dy); return [p[0] + (dx / l) * r, p[1] + (dy / l) * r]; };
    return { a: to(prev), p, b: to(next) };
  });
  return pts.map((c, i) => `${i === 0 ? 'M' : 'L'}${c.a[0].toFixed(1)},${c.a[1].toFixed(1)} Q${c.p[0]},${c.p[1]} ${c.b[0].toFixed(1)},${c.b[1].toFixed(1)}`).join(' ') + ' Z';
}

let phone: { screen: string; thumb: string; clip: string; id: string } | null = null;
if (device === 'phone') {
  const [screen, thumb] = await Promise.all([
    getImage({ src, width: Math.min(src.width * 2, 800), format: 'webp' }),
    getImage({ src: phoneThumb, format: 'webp' }),
  ]);
  phone = { screen: screen.src, thumb: thumb.src, clip: roundedQuad(QUAD, 27), id: `clip-${Math.abs(hash(src.src))}` };
}
function hash(s: string): number { let h = 0; for (const c of s) h = (h * 31 + c.charCodeAt(0)) | 0; return h; }
---
{device === 'laptop' ? (
  <div class="scene laptop-scene" role="img" aria-label={`${alt}, shown on a laptop`}>
    <div class="laptop" aria-hidden="true">
      <div class="lid">
        <span class="cam"></span>
        <div class:list={['screen', `fit-${fit}`]}>
          <Image src={src} alt="" widths={[480, 800, 1200, 1600].filter((w) => w <= src.width * 2)} sizes={sizes} loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : undefined} />
          <span class="glare"></span>
        </div>
      </div>
      <div class="base"><span class="lip"></span></div>
    </div>
  </div>
) : (
  <div class="scene phone-scene" role="img" aria-label={`${alt}, shown on a phone held in a hand`}>
    <Image class="photo" src={phoneScene} alt="" widths={[640, 960, 1400, 2100]} sizes={sizes} loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : undefined} />
    <svg class="overlay" viewBox={`0 0 ${SCENE_W} ${SCENE_H}`} preserveAspectRatio="xMidYMid slice" aria-hidden="true">
      <defs>
        <clipPath id={phone!.id}><path d={phone!.clip} /></clipPath>
        <linearGradient id={`${phone!.id}-g`} x1="0" y1="0" x2="1" y2="1">
          <stop offset="0" stop-color="#fff" stop-opacity=".14" />
          <stop offset=".45" stop-color="#fff" stop-opacity="0" />
        </linearGradient>
      </defs>
      <g clip-path={`url(#${phone!.id})`}>
        <g transform={MATRIX}>
          <rect x="-12" y="-12" width={SCREEN_W + 24} height={SCREEN_H + 24} fill="#0e0e10" />
          <image href={phone!.screen} x="0" y="0" width={SCREEN_W} height={SCREEN_H} preserveAspectRatio="xMidYMin slice" />
          <rect x="0" y="0" width={SCREEN_W} height={SCREEN_H} fill="#000" opacity=".1" />
          <path d={`M${SCREEN_W * 0.3} -10 H${SCREEN_W * 0.7} V${SCREEN_H * 0.026} q0 ${SCREEN_H * 0.016} -${SCREEN_H * 0.016} ${SCREEN_H * 0.016} H${SCREEN_W * 0.3 + SCREEN_H * 0.016} q-${SCREEN_H * 0.016} 0 -${SCREEN_H * 0.016} -${SCREEN_H * 0.016} Z`} fill="#050506" />
          <rect x="0" y="0" width={SCREEN_W} height={SCREEN_H} fill={`url(#${phone!.id}-g)`} />
        </g>
      </g>
      <image href={phone!.thumb} x={THUMB.x} y={THUMB.y} width={THUMB.w} height={THUMB.h} />
    </svg>
  </div>
)}

<style>
  .scene { position: relative; aspect-ratio: 16 / 10; width: 100%; overflow: hidden; border-radius: var(--radius); isolation: isolate; }

  /* ---------- Laptop: soft, muted studio scene ---------- */
  .laptop-scene {
    container-type: inline-size;
    background:
      /* soft daylight falling from the upper left across the wall */
      linear-gradient(118deg, transparent 18%, rgba(255, 244, 228, .07) 26%, transparent 34%, rgba(255, 244, 228, .05) 40%, transparent 47%),
      radial-gradient(55% 60% at 50% 40%, rgba(222, 212, 198, .2), transparent 72%),
      /* out-of-focus shapes in the room */
      radial-gradient(9% 14% at 9% 30%, rgba(214, 196, 170, .13), transparent 70%),
      radial-gradient(6% 9% at 92% 22%, rgba(214, 196, 170, .1), transparent 70%),
      radial-gradient(120% 90% at 40% 0%, #4d4944 0%, #2e2c2a 50%, #1a1a1b 100%);
  }
  /* Tabletop: a lighter plane with a soft far edge and a pool of light behind the laptop. */
  .laptop-scene::before {
    content: ''; position: absolute; inset: 69% 0 0 0; z-index: -1;
    background:
      radial-gradient(48% 70% at 50% 0%, rgba(240, 232, 220, .24), transparent 75%),
      linear-gradient(180deg, #57534d 0%, #3c3935 30%, #262523 100%);
    box-shadow: 0 -1px 0 rgba(255, 255, 255, .07), 0 -14px 30px -10px rgba(0, 0, 0, .35);
  }
  /* Vignette. */
  .laptop-scene::after { content: ''; position: absolute; inset: 0; background: radial-gradient(125% 100% at 50% 42%, transparent 52%, rgba(0, 0, 0, .5)); pointer-events: none; }
  .laptop { position: absolute; left: 50%; bottom: 23%; width: 63%; translate: -50% 0; }
  .lid {
    position: relative; padding: 2.1% 2.1% 2.6%; border-radius: 3.4cqw 3.4cqw .6cqw .6cqw / 3.4cqw 3.4cqw .6cqw .6cqw;
    background: linear-gradient(180deg, #121214, #08080a);
    box-shadow:
      0 0 0 .18cqw #5d5f66,            /* aluminium edge */
      0 0 0 .3cqw #2a2b2f,
      inset 0 0 0 .25cqw #1a1a1d,
      0 2.4cqw 4cqw -1.4cqw rgba(0, 0, 0, .55);
  }
  .cam { position: absolute; top: 0; left: 50%; translate: -50% 0; width: 8%; height: 2.6%; min-height: 4px; background: #08080a; border-radius: 0 0 .9cqw .9cqw; z-index: 2; }
  .cam::after { content: ''; position: absolute; left: 50%; top: 32%; width: .55cqw; height: .55cqw; translate: -50% 0; border-radius: 50%; background: radial-gradient(circle at 35% 35%, #3b4a63, #0b0d12 70%); }
  .screen { position: relative; aspect-ratio: 16 / 10; overflow: hidden; background: #000; border-radius: .5cqw .5cqw 0 0; }
  .screen :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: top center; }
  .screen.fit-contain { background: #fff; }
  .screen.fit-contain :global(img) { object-fit: contain; object-position: center; padding: 1.5%; }
  .glare { position: absolute; inset: 0; background: linear-gradient(115deg, rgba(255, 255, 255, .1) 0%, rgba(255, 255, 255, .03) 32%, transparent 33%); pointer-events: none; }
  .base {
    position: relative; width: 117%; margin-left: -8.5%; aspect-ratio: 100 / 2.9; margin-top: -.1cqw;
    border-radius: .3cqw .3cqw 48% 48% / .3cqw .3cqw 100% 100%;
    background: linear-gradient(180deg, #e7e8ec 0%, #c4c6cc 28%, #9a9ca3 70%, #6e7076 100%);
    box-shadow: inset 0 .12cqw 0 rgba(255, 255, 255, .7), 0 .9cqw 1.4cqw -.4cqw rgba(0, 0, 0, .7);
  }
  .lip { position: absolute; left: 50%; top: 0; width: 15%; height: 48%; translate: -50% 0; border-radius: 0 0 1cqw 1cqw / 0 0 .9cqw .9cqw; background: linear-gradient(180deg, #8b8d94, #b9bbc1); }
  /* Contact shadow on the table. */
  .base::after { content: ''; position: absolute; left: 4%; right: 4%; top: 70%; height: 130%; z-index: -1; border-radius: 50%; background: rgba(0, 0, 0, .55); filter: blur(1.2cqw); }

  /* ---------- Phone: photo + SVG screen overlay ---------- */
  .phone-scene { background: #141414; }
  .phone-scene :global(.photo) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .overlay { position: absolute; inset: 0; width: 100%; height: 100%; }
</style>
