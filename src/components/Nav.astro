---
import { site } from '../data/site';
interface Props { page: 'home' | 'software' | 'viz' | 'notfound'; sub?: boolean }
const { page, sub = false } = Astro.props;
const links = [
  { key: 'home', href: '/', label: 'Home', sym: '' },
  { key: 'software', href: '/software', label: 'Software Development', sym: '</>' },
  { key: 'viz', href: '/3d', label: '3D Visualization', sym: '◇' },
] as const;
---
<header class="nav-wrap">
  <div class="container nav">
    <a class="brand" href="/">
      <svg class="logo" viewBox="0 0 64 64" width="28" height="28" aria-hidden="true"><defs><linearGradient id="brand-z" x1="0" y1="0" x2="1" y2="1"><stop offset=".1" stop-color="#60a5fa"/><stop offset=".5" stop-color="#a78bfa"/><stop offset=".9" stop-color="#f59e0b"/></linearGradient></defs><rect width="64" height="64" rx="15" fill="#0b0b14"/><rect x=".75" y=".75" width="62.5" height="62.5" rx="14.25" fill="none" stroke="#ffffff" stroke-opacity=".14" stroke-width="1.5"/><path d="M17 17h30v6L26.5 41H47v6H17v-6l20.5-18H17z" fill="url(#brand-z)"/></svg>
      <span>{site.brand}</span>
    </a>
    <button class="menu-btn glass" type="button" aria-expanded="false" aria-controls="nav-list">Menu</button>
    <nav aria-label="Main">
      <ul id="nav-list">
        {links.map((l) => (
          <li>
            <a href={l.href} aria-current={l.key === page ? (sub ? 'true' : 'page') : undefined}>
              {l.sym && <span class="sym" aria-hidden="true">{l.sym} </span>}{l.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<style>
  .nav-wrap { position: sticky; top: 0; z-index: 50; background: rgba(11,11,20,.72); backdrop-filter: blur(12px); border-bottom: 1px solid var(--border); }
  .nav { display: flex; align-items: center; justify-content: space-between; height: 64px; }
  .brand { display: inline-flex; align-items: center; gap: 10px; font: 800 1.05rem var(--font-head); letter-spacing: .12em; text-decoration: none; white-space: nowrap; }
  .brand .logo { flex-shrink: 0; display: block; }
  ul { list-style: none; display: flex; gap: 8px; margin: 0; padding: 0; }
  nav a { display: block; padding: 8px 14px; border-radius: 999px; text-decoration: none; color: var(--muted); font-weight: 600; font-size: .95rem; }
  nav a:hover { color: var(--text); background: var(--glass); }
  nav a[aria-current] { color: var(--text); background: var(--glass-strong); border: 1px solid var(--border); }
  .menu-btn { display: none; color: var(--text); padding: 8px 16px; font: 600 .9rem var(--font-body); cursor: pointer; }
  /* Without JS (no html.js) the links stay a plain wrapped row and the menu button stays hidden. */
  @media (max-width: 759px) {
    .nav { height: auto; min-height: 64px; flex-wrap: wrap; padding-block: 8px; }
    ul { flex-wrap: wrap; gap: 4px; }
    nav a { padding: 6px 10px; font-size: .85rem; }
    :global(html.js) .nav { height: 64px; flex-wrap: nowrap; padding-block: 0; }
    :global(html.js) .menu-btn { display: block; }
    :global(html.js) nav { position: absolute; top: 64px; left: 0; right: 0; background: rgba(11,11,20,.96); border-bottom: 1px solid var(--border); display: none; }
    :global(html.js) nav.open { display: block; }
    :global(html.js) ul { flex-direction: column; flex-wrap: nowrap; gap: 8px; padding: 12px var(--gutter) 20px; }
    :global(html.js) nav a { padding: 8px 14px; font-size: .95rem; }
  }
</style>

<script>
  const btn = document.querySelector<HTMLButtonElement>('.menu-btn');
  const nav = document.querySelector('nav[aria-label="Main"]');
  const setOpen = (open: boolean) => {
    btn?.setAttribute('aria-expanded', String(open));
    nav?.classList.toggle('open', open);
  };
  btn?.addEventListener('click', () => setOpen(btn.getAttribute('aria-expanded') !== 'true'));
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape' || btn?.getAttribute('aria-expanded') !== 'true') return;
    setOpen(false);
    btn.focus();
  });
</script>
