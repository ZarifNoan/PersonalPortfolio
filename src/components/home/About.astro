---
import { site } from '../../data/site';
---
<section class="about container" aria-labelledby="about-title" data-reveal data-badge-release>
  <h2 id="about-title">About me</h2>
  <div class="body" data-badge-avoid>{site.about.map((p) => <p>{p}</p>)}</div>
</section>
<style>
  /* The text column is the smallest of 60ch, 44vw and the room left of the hanging badge: 100% minus the label
     column and gap (232px), the static badge's footprint from the container's right edge (Hero.astro: 210px card +
     31px offset = 241px) and 21px of clearance (its CSS sway swings the card's bottom corner up to ~19px). 1440px keeps
     its column (1100 − 494 = 606px ≥ the 44vw/60ch limits there); at 900–1000px it narrows so the card never covers it. */
  .about { display: grid; grid-template-columns: 200px minmax(0, min(60ch, 44vw, calc(100% - 494px))); gap: 32px; padding-block: 24px 32px; }
  h2 { font-size: .85rem; letter-spacing: .16em; text-transform: uppercase; color: var(--sw); padding-top: 6px; }
  p { margin: 0 0 16px; color: var(--muted); font-size: 1.08rem; }
  p:first-child { color: var(--text); font-size: 1.2rem; }
  p:last-child { margin-bottom: 0; }
  /* Justified only from 600px: at 390px the narrow column opened wide gaps between words (checked in screenshots). */
  @media (min-width: 600px) { p { text-align: justify; hyphens: auto; } }
  @media (max-width: 899px) { .about { grid-template-columns: 1fr; gap: 12px; } }
</style>
