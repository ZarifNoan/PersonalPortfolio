---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Lightbox from '../components/Lightbox.astro';
import { site } from '../data/site';
interface Props {
  title: string; description: string; page: 'home' | 'software' | 'viz' | 'notfound';
  /** True on a project detail page: its section's tab is marked as current, not as this exact page. */
  sub?: boolean;
  /** Link-preview image (absolute or root-relative URL, 1200 × 630); defaults to the site's /og.jpg. */
  ogImage?: string;
}
const { title, description, page, sub = false, ogImage } = Astro.props;
const fullTitle = page === 'home' ? `${site.name} | Portfolio` : `${title} | ${site.name}`;
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const og = new URL(ogImage ?? '/og.jpg', Astro.site).toString();
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {page === 'notfound' ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#0b0b14" />
    <meta name="google-site-verification" content="QdDcviYIlOEasSxd2hckgVAi_r09LT97eDKk1789IZE" />
    <!-- Runs before first paint so JS-only styles (e.g. the collapsed mobile menu) never flash; without JS nothing is hidden. -->
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body class={`page-${page}`}>
    <a class="skip-link glass" href="#main">Skip to content</a>
    <Nav page={page} sub={sub} />
    <main id="main"><slot /></main>
    <Footer />
    <Lightbox />
    <script>
      import { initReveal } from '../scripts/reveal';
      initReveal();
    </script>
  </body>
</html>
